# ───────────────────────────────────────────────────────────────────────
# .env template — copy to `.env` and fill in real values.
# `.env` is .gitignored; this `.env.example` IS committed so other devs
# (and future you) know which keys exist. Never put real secrets here.
#
# Both `crm-backend` and `external-api` containers read this file via
# `env_file: .env` in docker-compose.yml. Each service picks up the keys
# it knows about; unrelated keys are simply ignored.
# ───────────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════════════
#  DATABASE
# ════════════════════════════════════════════════════════════════════════
# DB_HOST is overridden to `postgres` (the service name) inside compose,
# so don't worry about it here — set the rest.
DB_NAME=crmdb
DB_USER=postgres
DB_PASSWORD=changeme_supersecret_password
DB_PORT=5432

# ════════════════════════════════════════════════════════════════════════
#  JWT / SESSION
# ════════════════════════════════════════════════════════════════════════
# Used to sign JWTs (crm_token cookie + access tokens). Must be the SAME
# in both crm-backend and external-api if a user logs in via CRM and the
# storefront SDK reads that session. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_64_random_hex_chars

# ════════════════════════════════════════════════════════════════════════
#  URLS  (frontends point at backends, backends embed URLs in emails)
# ════════════════════════════════════════════════════════════════════════
# Production:
#   CRM_FRONTEND_URL=https://tortacrm.com
#   CRM_BACKEND_URL=https://api.tortacrm.com
#   MAGAZ_BACKEND_URL=https://api.tortacrm.com
CRM_FRONTEND_URL=http://localhost:5174
CRM_BACKEND_URL=http://localhost:8001
MAGAZ_BACKEND_URL=http://localhost:8000

# ════════════════════════════════════════════════════════════════════════
#  GOOGLE OAUTH  (CRM backend only)
# ════════════════════════════════════════════════════════════════════════
# https://console.cloud.google.com/apis/credentials → OAuth client ID.
# Redirect URI must match what's set there exactly.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# ════════════════════════════════════════════════════════════════════════
#  SES (self-hosted email)
# ════════════════════════════════════════════════════════════════════════
# https://ses.tortacrm.com — proxied to Postfix on the VPS.
# SES_INTERNAL_KEY must match SES_API_KEY in /etc/systemd/system/ses.service
# on the VPS — that's how the API authenticates outbound mail.
SES_API_URL=https://ses.tortacrm.com
SES_INTERNAL_KEY=ses_internal_secret_from_vps
EMAIL_FROM=support@tortacrm.com

# ════════════════════════════════════════════════════════════════════════
#  AWS S3  (CRM backend uses for media uploads)
# ════════════════════════════════════════════════════════════════════════
# IAM user with s3:PutObject + s3:DeleteObject on the bucket. CloudFront
# URL is optional — if set, public photo URLs go through CF instead of
# the raw S3 endpoint (saves bandwidth + nicer URLs).
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=torta-media-prod
AWS_S3_REGION=eu-central-1
AWS_CLOUDFRONT_URL=https://d1234abcd.cloudfront.net

# ════════════════════════════════════════════════════════════════════════
#  PAYMENT PROVIDER CREDENTIALS (encrypted at rest)
# ════════════════════════════════════════════════════════════════════════
# 32-byte Fernet key used to encrypt Stripe/PayPal/etc. secret keys
# stored in crm_payment_providers. Generate ONCE then never change:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=44_char_urlsafe_base64_fernet_key=

# ════════════════════════════════════════════════════════════════════════
#  STRIPE CONNECT  (CRM backend only — for merchants linking Stripe)
# ════════════════════════════════════════════════════════════════════════
# https://dashboard.stripe.com/settings/connect → "Connect" → "Settings"
# → OAuth settings. Leave blank if you don't use Stripe Connect.
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_REDIRECT_URI=http://localhost:5174/org/_/payments/stripe-callback

# ════════════════════════════════════════════════════════════════════════
#  FRONTEND BUILD ARGS (read by Dockerfile, not by backends)
# ════════════════════════════════════════════════════════════════════════
# These are baked into the Vite bundle at BUILD time. For prod:
#   VITE_API_BASE=https://api.tortacrm.com
#   VITE_EXTERNAL_API_BASE=https://api.tortacrm.com
VITE_API_BASE=http://localhost:8001
VITE_EXTERNAL_API_BASE=http://localhost:8000

# ════════════════════════════════════════════════════════════════════════
#  KV STORE (optional)
# ════════════════════════════════════════════════════════════════════════
# Pending OTPs, rate-limit counters etc. live in Postgres by default —
# set USE_PG_KV=0 to fall back to in-process dicts (single-instance only).
# Set REDIS_URL to use Redis instead of Postgres (faster, optional).
USE_PG_KV=1
# REDIS_URL=redis://default:password@redis-host:6379/0
