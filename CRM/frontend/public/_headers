# Cloudflare Workers/Pages reads this file from the served assets dir (Vite copies
# public/_headers -> dist/_headers). Rules are cumulative; more specific first.
#
# CSP origin allowlist (why each is here):
#   script-src   self + *.paddle.com   — app JS is self-hosted; Paddle.js loads from cdn.paddle.com
#   style-src    self + unsafe-inline + fonts.googleapis.com — React inline styles + Google Fonts CSS
#   font-src     self + data + fonts.gstatic.com — Google Fonts files
#   connect-src  self + api-crm (https+wss) + api (External) + *.paddle.com + blob/data — API, WebSockets, Paddle, 3D/model blobs
#   frame-src    *.paddle.com          — Paddle inline/overlay checkout iframe
#   img/media    self data blob https: — avatars (googleusercontent/R2), product/chat media, model-viewer blobs
#   object-src none, base-uri self, frame-ancestors none — XSS/clickjacking hardening
# Google OAuth is a top-level redirect (not a subresource), so no Google script/frame origin is needed.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.paddle.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api-crm.tortacrm.com wss://api-crm.tortacrm.com https://api.tortacrm.com https://*.paddle.com https://cloudflareinsights.com blob: data:; frame-src https://*.paddle.com; media-src 'self' blob: https: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
