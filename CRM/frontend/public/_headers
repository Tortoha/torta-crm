# Cloudflare Workers/Pages reads this file from the served assets dir (Vite copies
# public/_headers -> dist/_headers). Rules are cumulative; more specific first.
#
# CSP origin allowlist (why each is here):
#   script-src   self + 'sha256-CCQhYnYXweM2IaxG4JAwNw7XivrPDFLUSr7HJQkM6G8=' (the inline gtag
#                init block in index.html — if you edit that snippet, the browser CSP error will
#                print the new hash; swap it in here) + *.paddle.com + cloudflareinsights +
#                googletagmanager/googleadservices/doubleclick — app JS self-hosted; Paddle.js
#                from cdn.paddle.com; CF analytics; Google Ads gtag + conversion tracking
#   style-src    self + unsafe-inline + fonts.googleapis.com — React inline styles + Google Fonts CSS
#   font-src     self + data + fonts.gstatic.com — Google Fonts files
#   connect-src  self + api-crm (https+wss) + api (External) + *.paddle.com + cloudflareinsights + Google Ads (googletagmanager/googleadservices/doubleclick/google.com) + blob/data — API, WebSockets, Paddle, conversion pings, 3D/model blobs
#   frame-src    *.paddle.com + td.doubleclick.net + googletagmanager — Paddle checkout iframe; Google Ads conversion frames
#   img/media    self data blob https: — avatars (googleusercontent/R2), product/chat media, model-viewer blobs, Google Ads pixels
#   object-src none, base-uri self, frame-ancestors none — XSS/clickjacking hardening
# Google OAuth login is a top-level redirect (not a subresource). The Google origins above are for Google Ads conversion tracking (gtag.js), not OAuth.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-CCQhYnYXweM2IaxG4JAwNw7XivrPDFLUSr7HJQkM6G8=' https://*.paddle.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api-crm.tortacrm.com wss://api-crm.tortacrm.com https://api.tortacrm.com https://*.paddle.com https://cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com blob: data:; frame-src https://*.paddle.com https://td.doubleclick.net https://www.googletagmanager.com; media-src 'self' blob: https: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
