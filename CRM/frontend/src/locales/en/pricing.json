    "faq": {
      "title": "Questions about pricing",
      "items": {
        "free":    { "q": "Is Free really free?", "a": "Yes — Free is a permanent plan, not a trial. You can run a real storefront on it as long as you stay within the limits. No card, no expiry." },
        "noTrial": { "q": "Is there a free trial on paid plans?", "a": "No — paid plans charge immediately when you subscribe. If you want to try Torta first, use the Free plan (it's not a trial — it never expires). If a paid plan turns out not to fit, you can get a full refund within 14 days, no questions asked." },
        "billing": { "q": "How does billing work?", "a": "Billing is at the organization level — one subscription covers every project inside that organization. The org owner is the only person who can change the plan." },
        "currency":{ "q": "What currency are charges in?", "a": "All charges are in USD, processed by Paddle (our payment processor). Paddle automatically converts to your local currency on the invoice." },
        "vat":     { "q": "Are taxes included?", "a": "VAT, GST and US sales tax are calculated at checkout based on your billing country. Paddle handles all tax remittance — you don't deal with it." },
        "upgrade": { "q": "Can I change plans?", "a": "Anytime. Upgrades take effect immediately and are pro-rated. Downgrades take effect at your next billing cycle." },
        "cancel":  { "q": "What happens if I cancel?", "a": "Your subscription stays active until the end of the paid period. After that, your organization drops to Free tier — your data isn't deleted, but features above the Free limit pause until you reactivate." },
        "refund":  { "q": "What about refunds?", "a": "We offer a 14-day money-back guarantee on first-time subscriptions. See the full Refund Policy for details." }
      }
    },

