# Production build-time config (public URLs — NOT secrets).
# Loaded automatically by `npm run build` (Vite production mode); `npm run dev`
# ignores this file and falls back to the localhost defaults in src/api.js.
# This guarantees a LOCAL `npm run build` produces a prod-correct bundle even
# without the Cloudflare Worker build-env — preventing the "frontend points at
# localhost" breakage. Cloudflare's own VITE_* build vars still take precedence.
VITE_API_BASE=https://api-crm.tortacrm.com
VITE_EXTERNAL_API_BASE=https://api.tortacrm.com
