# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────
dist/
build/

# ── Environment & secrets ─────────────────────────────────
.env
.env.*
*.local
!*.local.example
# Templates ARE committed — they document required keys without real values.
!.env.example
!.env.*.example
# Frontend build-time config holds only public URLs, not secrets.
!CRM/frontend/.env.production

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/

# ── Uploads (user-generated files) ────────────────────────
uploads/

# ── Private working notes / local-only files ──────────────
# Project notes, editor state and assistant config are kept locally,
# never committed. Diploma documents (PII) must never be added.
Notes/
.obsidian/
.claude/
CLAUDE.md
.impeccable.md
Отчет/
*.docx
*.doc
make_deposit.py
deposit.html
response.json

# ── OS & editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
